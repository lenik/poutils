#: src/poedit.c:305
msgid "Purpose:"
msgstr "Propósito:"

#: src/poedit.c:306
msgid "Efficiently apply many already-translated l10n messages into PO files."
msgstr "Aplicar de forma eficiente muchos mensajes l10n ya traducidos en archivos PO."

#: src/poedit.c:307
msgid "poedit is usually used to supplement translations by providing only newly added entries."
msgstr "poedit suele usarse para complementar traducciones aportando solo entradas nuevas."

#: src/poedit.c:309
msgid "This tool is mainly designed for AI-assisted coding workflows."
msgstr "Esta herramienta está pensada principalmente para flujos de trabajo asistidos por IA."

#: src/poedit.c:311
msgid "AI usage requirements:"
msgstr "Requisitos de uso con IA:"

#: src/poedit.c:313
msgid "1) Translate multiple messages in advance (manually) before running poedit."
msgstr "1) Traducir varios mensajes de antemano (manualmente) antes de ejecutar poedit."

#: src/poedit.c:314
msgid "2) Use poedit for batch update to avoid one-by-one tool calls."
msgstr "2) Usar poedit para actualización por lotes y evitar llamadas una a una."

#: src/poedit.c:315
msgid "3) Do NOT use poedit to generate placeholders or copy msgid to msgstr."
msgstr "3) NO use poedit para generar marcadores de posición ni copiar msgid a msgstr."

#: src/poedit.c:316
msgid "Doing so defeats the purpose of this tool."
msgstr "Hacerlo anula el propósito de esta herramienta."

#: src/poedit.c:317
msgid "4) AI must first identify missing entries in current translations,"
msgstr "4) La IA debe primero identificar entradas faltantes en las traducciones actuales,"

#: src/poedit.c:318
msgid "translate them manually."
msgstr "traducirlas manualmente."

#: src/poedit.c:319
msgid "then apply to PO files with this tool in one batch."
msgstr "luego aplicarlas a los archivos PO con esta herramienta en un solo lote."

#: src/poedit.c:323
msgid "Usage: poedit [OPTIONS]"
msgstr "Uso: poedit [OPCIONES]"

#: src/poedit.c:326
msgid "Input format: (langs can be inferred from --langs, filename or subdir)"
msgstr "Formato de entrada: (langs puede inferirse de --langs, nombre de archivo o subdirectorio)"

#: src/poedit.c:327
msgid "langs<TAB>msgid<TAB>msgstr[<TAB>msgstr...]"
msgstr "langs<TAB>msgid<TAB>msgstr[<TAB>msgstr...]"

#: src/poedit.c:328
msgid "-or-"
msgstr "-o-"

#: src/poedit.c:329
msgid "msgid<TAB>msgstr[<TAB>msgstr...]"
msgstr "msgid<TAB>msgstr[<TAB>msgstr...]"

#: src/poedit.c:331
msgid "langs: comma-separated language codes; one msgstr column per lang."
msgstr "langs: códigos de idioma separados por comas; una columna msgstr por idioma."

#: src/poedit.c:333
msgid "langs conflict resolution: [langs<TAB>] > [--langs] > [filename] > [subdir]"
msgstr "resolución de conflictos langs: [langs<TAB>] > [--langs] > [filename] > [subdir]"

#: src/poedit.c:335
msgid "Options:"
msgstr "Opciones:"

#: src/poedit.c:337
msgid "mapping file or directory (optional: default stdin)"
msgstr "archivo o directorio de mapeo (opcional: stdin por defecto)"

#: src/poedit.c:339
msgid "comma-separated language codes for mapping rows without langs column"
msgstr "códigos de idioma separados por comas para filas sin columna langs"

#: src/poedit.c:341
msgid "PO directory (default: po)"
msgstr "directorio PO (predeterminado: po)"

#: src/poedit.c:343
msgid "show plan but do not modify files"
msgstr "mostrar el plan sin modificar archivos"

#: src/poedit.c:345
msgid "repeat for more verbose loggings"
msgstr "repetir para registros más detallados"

#: src/poedit.c:347
msgid "show less logging messages"
msgstr "mostrar menos mensajes de registro"

#: src/poedit.c:349
msgid "show this help and exit"
msgstr "mostrar esta ayuda y salir"

#: src/poedit.c:351
msgid "show version and exit"
msgstr "mostrar la versión y salir"

#: src/poedit.c:420
#, c-format
msgid "error: input not found: %s\n"
msgstr "error: entrada no encontrada: %s\n"

#: src/poedit.c:426
#, c-format
msgid "error: failed to read mapping file: %s\n"
msgstr "error: no se pudo leer el archivo de mapeo: %s\n"

#: src/poedit.c:440
#, c-format
msgid "error: unsupported input type: %s\n"
msgstr "error: tipo de entrada no admitido: %s\n"

#: src/poedit.c:446
#, c-format
msgid "error: failed to open input directory: %s\n"
msgstr "error: no se pudo abrir el directorio de entrada: %s\n"

#: src/poedit.c:549
msgid "error: input contains only msgid<TAB>msgstr entries; explicit language is required."
msgstr "error: la entrada solo contiene entradas msgid<TAB>msgstr; se requiere idioma explícito."

#: src/poedit.c:551
msgid "Please use [langs<TAB>]msgid<TAB>msgstr... or --langs."
msgstr "Use [langs<TAB>]msgid<TAB>msgstr... o --langs."

#: src/poedit.c:562 src/poedit.c:637
#, c-format
msgid "error: invalid field count in %s:%d\n"
msgstr "error: número de campos no válido en %s:%d\n"

#: src/poedit.c:581 src/poedit.c:592 src/poedit.c:605
#, c-format
msgid "error: langs/msgstr count mismatch in %s:%d (langs=%zu, fields=%zu)\n"
msgstr "error: recuento langs/msgstr no coincide en %s:%d (langs=%zu, fields=%zu)\n"

#: src/poedit.c:616 src/poedit.c:628
#, c-format
msgid "error: no language resolved for %s:%d\n"
msgstr "error: no se resolvió el idioma para %s:%d\n"

#: src/poedit.c:663
#, c-format
msgid "[dry-run] %s: %s (updated=%d, fuzzy_removed=%d)\n"
msgstr "[dry-run] %s: %s (actualizados=%d, fuzzy_eliminados=%d)\n"

#: src/poedit.c:664
msgid "would update"
msgstr "se actualizaría"

#: src/poedit.c:664 src/poedit.c:667
msgid "no changes"
msgstr "sin cambios"

#: src/poedit.c:666
#, c-format
msgid "%s: %s (updated=%d, fuzzy_removed=%d)\n"
msgstr "%s: %s (actualizados=%d, fuzzy_eliminados=%d)\n"

#: src/poedit.c:667
msgid "updated"
msgstr "actualizado"

#: src/poedit.c:688
#, c-format
msgid "warn: skip missing PO file: %s\n"
msgstr "aviso: se omite el archivo PO ausente: %s\n"

#: src/poedit.c:701
#, c-format
msgid "error: cannot infer language from target file: %s\n"
msgstr "error: no se puede inferir el idioma del archivo destino: %s\n"

#: src/poedit.c:707
#, c-format
msgid "warn: no mapping found for language %s; skip %s\n"
msgstr "aviso: no hay mapeo para el idioma %s; se omite %s\n"

#: src/poedit.c:747
msgid "error: no mapping entries loaded"
msgstr "error: no se cargaron entradas de mapeo"
